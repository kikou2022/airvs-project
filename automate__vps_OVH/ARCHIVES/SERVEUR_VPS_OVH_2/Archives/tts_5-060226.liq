####################################################################################################################
####################################  PROCESSING AUDIO RADIO - TALK & MUSIQUE  ####################################
####################################        CIBLE -16 LUFS / FM - DAB - WEB        ################################
####################################################################################################################

# --------------------------------------------------
# 1. Gate très léger (silence studio / micros ouverts)
# --------------------------------------------------
radio = ladspa.gate(
  radio,
  threshold = -60.,
  attack = 0.1,
  hold = 0.5,
  decay = 200.,
  range = -20.
)

# --------------------------------------------------
# 2. AGC lent (uniformisation des sources)
# --------------------------------------------------
radio = normalize(
  radio,
  target = -1.0,
  window = 0.05,
  gain_min = -6.,
  gain_max = 3.
)

# --------------------------------------------------
# 3. EQ Broadcast doux (FM-safe)
# --------------------------------------------------
radio = ladspa.tap_equalizer(
  band_1_freq = 80.,   band_1_gain = 3.,    # chaleur voix
  band_3_gain = -1.,                       # médiums boxy
  band_6_gain = 1.5,                       # présence
  band_8_gain = 2.,                        # air
  radio
)

# --------------------------------------------------
# 4. Compresseur Multibande principal
# --------------------------------------------------
radio = compress.multiband(radio, [
  { frequency=200.,   attack=5., release=60., ratio=2.0, threshold=-12., gain=1. },
  { frequency=3000.,  attack=3., release=40., ratio=2.5, threshold=-10., gain=1. },
  { frequency=20000., attack=2., release=80., ratio=2.0, threshold=-8.,  gain=0.5 }
])

# --------------------------------------------------
# 5. De-esser (voix / sifflantes)
# --------------------------------------------------
radio = ladspa.tap_deesser(
  radio,
  threshold_level = -6.,
  frequency = 8500.
)

# --------------------------------------------------
# 6. Limiteur final (FM / DAB / Web safe)
# --------------------------------------------------
radio = ladspa.tap_limiter(
  radio,
  limit_level = -1.0
)

####################################################################################################################
#########################################   FIN PROCESSING AUDIO   ################################################
####################################################################################################################
